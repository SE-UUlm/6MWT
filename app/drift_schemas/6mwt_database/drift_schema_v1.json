      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NULL, \"timestamp\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP), \"height\" INTEGER NOT NULL, \"age\" INTEGER NOT NULL);"
        }
      ]
    },
    {
