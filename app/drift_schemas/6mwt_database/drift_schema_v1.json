      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"walk_sessions\" (\"id\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"duration\" INTEGER NOT NULL, \"distance\" REAL NOT NULL, \"phase\" TEXT NOT NULL, \"profile_id\" INTEGER NOT NULL REFERENCES profiles (id), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sensor_samples",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sensor_samples\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"timestamp\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES walk_sessions (id), \"type\" TEXT NOT NULL, \"source_id\" TEXT NOT NULL, \"values\" TEXT NOT NULL);"
        }
